{
  "manifest_version": 3,
  "name": "Kavacham V2 Shield Guard",
  "version": "2.0",
  "description": "Real-time Live Phishing, WHOIS, and Homograph Guard",
  "permissions": ["tabs", "activeTab", "storage"],
  "host_permissions": ["http://localhost:5000/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kavacham Shield"
  }
}